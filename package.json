{
  "name": "sklad-salesdrive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma db push --skip-generate && node prisma/seed.mjs && next build",
    "start": "next start",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "db:studio": "prisma studio",
    "yml:inspect": "node --env-file=.env scripts/yml-inspect.mjs",
    "postinstall": "prisma generate",
    "build:local": "prisma generate && next build"
  },
  "dependencies": {
    "@prisma/client": "^6.10.0",
    "fast-xml-parser": "^5.2.0",
    "jsbarcode": "^3.12.1",
    "next": "^15.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "^6.10.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
