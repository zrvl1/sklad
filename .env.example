# ===== База даних (Neon PostgreSQL) =====
# У Neon: Dashboard → Connect. Для локальної роботи використовуйте гілку "dev", для сервера — "main".
# DATABASE_URL — рядок з "-pooler" у адресі (через пул), DIRECT_URL — без "-pooler".
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# ===== SalesDrive =====
SALESDRIVE_URL="https://ВАШ_АКАУНТ.salesdrive.me"
# API-ключ: Товари (додавання та редагування + видалення — для видалення з додатку), Категорії (додавання та редагування)
SALESDRIVE_FORM_KEY="вставте_ключ"
# Необов'язково, для звіту по продажах: ОКРЕМИЙ ключ лише з правами «Заявки: читання» і «Статуси заявки: читання»
SALESDRIVE_ORDERS_KEY=""
# Окремий YML-експорт для складу (з собівартістю) — посилання нікому не передавати
SALESDRIVE_YML_URL="https://..."

# ===== Безпека =====
# Випадковий рядок 64 символи. Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""
# Секрет для автосинхронізації за розкладом (так само згенерувати)
CRON_SECRET=""
# На сервері з https залиште порожнім (cookie будуть secure автоматично)
COOKIE_SECURE=""

# ===== Перший користувач (npm run db:seed) =====
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="мінімум 10 символів"
ADMIN_NAME="Адміністратор"

# Валюти закупівлі (поки вимкнено). Увімкнути: ENABLE_CURRENCY="true" і додати ключу право «Курси валют: читання»
ENABLE_CURRENCY=""
