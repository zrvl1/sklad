// Схема бази даних складського сервісу для SalesDrive.
// SalesDrive — джерело правди для товарів і залишків.
// Тут зберігаємо те, чого в CRM немає: комірки, документи приходу, журнал дій, витрати.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // з'єднання через пул (для сайту)
  directUrl = env("DIRECT_URL")   // пряме з'єднання (для npm run db:push)
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  login        String     @unique
  passwordHash String
  role         String     @default("manager") // admin | manager | storekeeper
  active       Boolean    @default(true)
  passwordChangedAt DateTime @default(now()) // зміна пароля завершує всі старі сесії
  createdAt    DateTime   @default(now())
  receipts     Receipt[]  @relation("ReceiptCreatedBy")
  posted       Receipt[]  @relation("ReceiptPostedBy")
  logs         ActionLog[]
  expenses     Expense[]
  inventories  Inventory[]
  moves        StockMove[]
  writeOffs    WriteOff[]
}

// Склад (точка). sdStockId — ID складу в SalesDrive (Установки → ... → API).
model Warehouse {
  id        Int            @id @default(autoincrement())
  name      String
  sdStockId String?
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  cells     Cell[]
  stocks    StockBalance[]
  receipts  Receipt[]
  expenses  Expense[]
  inventories Inventory[]
  moves     StockMove[]
  writeOffs WriteOff[]
}

model Supplier {
  id            Int       @id @default(autoincrement())
  name          String    @unique
  phone         String?
  note          String?
  createdAt     DateTime  @default(now())
  feedUrl       String?   // посилання на XML/YML постачальника
  feedPriceType String    @default("rrp") // що означає <price> у фіді: rrp — РРЦ (ціна продажу), cost — закупівля
  currency      String    @default("UAH") // валюта розрахунків з постачальником
  roundTo       Int       @default(10)    // округлення ціни продажу з РРЦ (грн)
  feedAt        DateTime? // коли востаннє завантажено фід
  feedError     String?
  manualPriceCats String? // JSON [id категорії]: у цих категоріях (і підкатегоріях) ціну ставлять вручну, РРЦ × курс не застосовується
  extraParams   String?   // характеристики, що додаються до кожного товару з фіду: рядки «Назва: значення»
  ledgerFrom    DateTime? // розрахунки (борг, оплати) ведуться з цієї дати; раніші приходи вважаються оплаченими
  receipts      Receipt[]
  codes         ProductCode[]
  items         SupplierItem[]
  payments      SupplierPayment[]
}

// Товари з фіду постачальника (довідник: шукаємо за кодом, створюємо картки)
model SupplierItem {
  id         Int      @id @default(autoincrement())
  supplierId Int
  code       String   // <code> — код товару в накладній
  article    String?
  name       String
  price      Float    @default(0)
  currency   String   @default("UAH")
  available  Boolean  @default(true)
  category   String?
  brand      String?
  description String?
  params     String?  // JSON [{name, value}]
  pictures   String?  // JSON [url]
  updatedAt  DateTime @updatedAt
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([supplierId, code])
  @@index([supplierId, article])
}

// Оплати постачальнику у валюті: скільки валюти й скільки гривень реально витрачено (курсова різниця)
model SupplierPayment {
  id          Int      @id @default(autoincrement())
  supplierId  Int
  date        DateTime @default(now())
  currency    String
  amount      Float    // у валюті постачальника
  uah         Float    // скільки гривень витрачено (купівля валюти / готівка)
  bookedUah   Float    @default(0) // за яким курсом цей борг був у собівартості (середній курс боргу)
  diffUah     Float    @default(0) // курсова різниця: uah - bookedUah (+ витрата, − дохід)
  expenseId   Int?     // запис у «Гроші за місяць»
  note        String?
  createdById Int
  createdAt   DateTime @default(now())
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId, date])
}

model Product {
  id               Int            @id @default(autoincrement())
  sdId             String?        @unique // поле "ID" у SalesDrive
  name             String
  nameForDocuments String?
  images           String?        // фото: JSON-масив URL (перше — головне); з YML SalesDrive або завантажені в додаток
  keywords         String?        // пошукові запити (з YML SalesDrive), основна мова
  keywordsUa       String?        // пошукові запити українською, якщо YML їх віддає
  country          String?        // країна виробник (з YML SalesDrive: country_of_origin)
  nameTranslate    String?        // назва другою мовою (у SalesDrive: nameTranslate); порожня — іде основна
  textEditedAt     DateTime?      // коли тексти змінено в додатку: синхронізація з YML кілька годин їх не перезаписує
  categorySdId     String?
  categoryName     String?
  price            Float          @default(0) // ціна продажу (у SalesDrive: costPerItem)
  priceCurrency    String?        // валюта ціни продажу (зазвичай UAH)
  cost             Float          @default(0) // собівартість у гривні (у SalesDrive: expenses)
  costCurrency     String?        // валюта закупівлі (USD, EUR…), якщо собівартість задана у валюті
  costOriginal     Float?         // собівартість у валюті закупівлі
  discountValue    Float?
  discountType     String?        // percent | amount
  discountFrom     DateTime?
  discountTo       DateTime?
  sku              String?
  barcode          String?
  manufacturer     String?
  supplierName     String?
  description      String?        // опис (HTML або текст), іде в SalesDrive
  descriptionTranslate String?    // опис другою мовою (у SalesDrive: descriptionTranslate)
  params           String?        // характеристики: JSON [{name, type, value}]
  search           String         @default("") // нижній регістр: назва + sku + штрихкод + ID, для пошуку
  deletedAt        DateTime?      // видалено (у CRM або з додатку) — у списках не показується, історія зберігається
  baseProductId    Int?           // картка-комплект (вітрина для SEO): посилається на основний фізичний товар
  kitQty           Float          @default(1) // скільки штук основного товару в одній картці
  minStock         Float?         // мінімальний залишок (порожньо — додаток підказує за продажами)
  supplierId       Int?           // постачальник з фідом (для РРЦ і оновлень)
  supplierCode     String?        // код товару у фіді/накладній постачальника
  rrp              Float?         // РРЦ постачальника у валюті rrpCurrency
  rrpCurrency      String?
  priceLocked      Boolean        @default(false) // ціна задана вручну — не перераховувати з РРЦ × курс
  seoAt            DateTime?      // коли завантажено SEO-тексти (назва, опис, запити) з файлу
  sdKitPending     Boolean        @default(false) // картку створено в додатку — у SalesDrive ще треба позначити «Комплект» і додати основний
  base             Product?       @relation("KitBase", fields: [baseProductId], references: [id], onDelete: SetNull)
  kits             Product[]      @relation("KitBase")
  syncedAt         DateTime?      // коли востаннє оновлено з SalesDrive
  syncError        String?        // остання помилка відправки в SalesDrive
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  stocks           StockBalance[]
  cells            ProductCell[]
  receiptLines     ReceiptLine[]
  codes            ProductCode[]
  moves            StockMove[]
  inventoryLines   InventoryLine[]
  saleLines        SdOrderLine[]
  writeOffLines    WriteOffLine[]

  @@index([barcode])
  @@index([sku])
  @@index([baseProductId])
}

// Копія залишку із SalesDrive по складу
model StockBalance {
  productId   Int
  warehouseId Int
  qty         Float     @default(0)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
}

// Комірка: код на кшталт "A-03-2" (ряд-стелаж-полиця)
model Cell {
  id          Int           @id @default(autoincrement())
  code        String
  warehouseId Int
  note        String?
  createdAt   DateTime      @default(now())
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  products    ProductCell[]
  lines       ReceiptLine[]
  inventoryLines InventoryLine[]
  moves       StockMove[]
  writeOffLines WriteOffLine[]

  @@unique([warehouseId, code])
}

// Що лежить у комірці (один товар може бути в кількох комірках)
model ProductCell {
  productId Int
  cellId    Int
  qty       Float    @default(0)
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cell      Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@id([productId, cellId])
}

// Документ приходу
model Receipt {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  date        DateTime      @default(now())
  warehouseId Int
  supplierId  Int?
  invoiceNo   String?       // номер накладної постачальника
  note        String?
  status      String        @default("draft") // draft | posted
  currency    String        @default("UAH") // валюта закупівлі
  rate        Float         @default(1)     // курс до гривні на момент приходу (з SalesDrive)
  rateFixed   Boolean       @default(false)
  paidEarlier Boolean       @default(false) // оплачено раніше (напр. внесення наявного товару) — не рахувати в «Русі грошей» за місяць // курс вказано вручну (напр. за ним уже купили валюту) — не брати курс дня
  total       Float         @default(0)     // сума в гривні
  totalCurrency Float       @default(0)     // сума у валюті приходу
  createdById Int
  postedById  Int?
  postedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  supplier    Supplier?     @relation(fields: [supplierId], references: [id])
  createdBy   User          @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  postedBy    User?         @relation("ReceiptPostedBy", fields: [postedById], references: [id])
  lines       ReceiptLine[]

  @@index([date])
}

model ReceiptLine {
  id        Int     @id @default(autoincrement())
  receiptId Int
  productId Int
  qty       Float
  cost      Float   // закупівельна ціна за одиницю у валюті приходу
  newPrice  Float?  // нова ціна продажу (якщо змінюємо при приході)
  cellId    Int?
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  cell      Cell?   @relation(fields: [cellId], references: [id], onDelete: SetNull)
}

// Витрати — на майбутнє (оренда, доставка, зарплата…)
model Expense {
  id          Int        @id @default(autoincrement())
  date        DateTime   @default(now())
  kind        String     @default("expense") // expense — витрата бізнесу | owner — вивів собі / особисте | invest — вклав власні | income — інший дохід
  category    String
  amount      Float
  account     String?    // з якого рахунку: ФОП, картка, готівка
  warehouseId Int?
  legalEntity String?    // ФОП
  note        String?
  createdById Int
  createdAt   DateTime   @default(now())
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  createdBy   User       @relation(fields: [createdById], references: [id])
}

// Журнал дій: хто, що і коли зробив
model ActionLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

// Спроби входу: для захисту від підбору пароля і для журналу
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  login     String
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([login, createdAt])
  @@index([ip, createdAt])
}

// Додаткові коди товару: артикули постачальників і додаткові штрихкоди (напр. заводський).
// Пошук у приході, на складі й в інвентаризації працює за всіма кодами.
model ProductCode {
  id         Int       @id @default(autoincrement())
  productId  Int
  code       String    @unique
  type       String    // supplier | barcode
  supplierId Int?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// Журнал руху товару: прихід, інвентаризація, переміщення між комірками, автосписання з комірок після продажу
model StockMove {
  id          Int       @id @default(autoincrement())
  productId   Int
  warehouseId Int
  cellId      Int?
  qty         Float     // + надходження в комірку/на склад, - вибуття
  type        String    // receipt | inventory | cell-move | cell-adjust | sale-auto
  docType     String?   // receipt | inventory
  docId       Int?
  note        String?
  userId      Int?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  cell        Cell?     @relation(fields: [cellId], references: [id], onDelete: SetNull)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([cellId])
}

model Inventory {
  id          Int             @id @default(autoincrement())
  number      String          @unique
  date        DateTime        @default(now())
  warehouseId Int
  status      String          @default("draft") // draft | posted
  note        String?
  createdById Int
  postedAt    DateTime?
  createdAt   DateTime        @default(now())
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy   User            @relation(fields: [createdById], references: [id])
  lines       InventoryLine[]
}

model InventoryLine {
  id          Int       @id @default(autoincrement())
  inventoryId Int
  productId   Int
  cellId      Int?
  counted     Float
  systemQty   Float?    // залишок у SalesDrive на момент проведення (заповнюється при проведенні)
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])
  cell        Cell?     @relation(fields: [cellId], references: [id], onDelete: SetNull)
}

// Заявки з SalesDrive — лише те, що потрібно для звітів. Дані клієнтів НЕ зберігаємо.
model SdOrder {
  id          Int           @id // ID заявки в SalesDrive
  orderTime   DateTime
  updateAt    DateTime?
  statusId    Int
  amount      Float         @default(0) // сума заявки
  costAmount  Float         @default(0) // собівартість
  profit      Float         @default(0) // прибуток SalesDrive (без комісії Prom)
  commission  Float         @default(0) // комісія майданчика (Prom)
  site        String?       // звідки заявка: Prom, Хорошоп…
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  saleDate    DateTime?     // дата продажу (отримання посилки)
  lines       SdOrderLine[]
  ttns        OrderTtn[]
  pack        OrderPack?

  @@index([orderTime])
}

model SdOrderLine {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int?     // наш товар, якщо вдалося зіставити
  sdProductId String?
  name      String
  sku       String?
  barcode   String?
  qty       Float
  price     Float
  discount  Float    @default(0)
  costPrice Float    @default(0)
  order     SdOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// Курси валют із SalesDrive (кеш; оновлюється при синхронізації)
model Currency {
  code      String   @id
  rate      Float    // скільки гривень за 1 одиницю валюти
  updatedAt DateTime @updatedAt
}

// Шаблон заповнення нового товару: опис і характеристики за категорією (categoryName = null — для всіх)
model ProductTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  categoryName String?  @unique
  description  String?  // можна використовувати {name}, {sku}, {manufacturer}, {category}, {supplier}
  descriptionTranslate String? // опис українською
  keywords     String?  // пошукові запити RU (з підстановками)
  keywordsUa   String?  // пошукові запити UA (порожньо — перекладаються з RU)
  country      String?  // країна виробник за замовчуванням
  params       String?  // JSON [{name, type, value}]
  manufacturer String?
  supplierName String?
  updatedAt    DateTime @updatedAt
}

// Журнал видалених товарів: щоб не забути прибрати їх на Prom, Horoshop та інших сайтах
model DeletedProduct {
  id          Int                  @id @default(autoincrement())
  productId   Int?
  sdId        String?
  name        String
  sku         String?
  barcode     String?
  categoryName String?
  price       Float    @default(0)
  source      String               // app — видалено в додатку; crm — зник із SalesDrive
  reason      String?
  deletedById Int?
  deletedAt   DateTime             @default(now())
  sites       DeletedProductSite[]

  @@index([deletedAt])
}

model DeletedProductSite {
  id         Int            @id @default(autoincrement())
  deletedId  Int
  site       String         // назва сайту з Налаштувань (Prom, Horoshop…)
  status     String         @default("todo") // todo — треба видалити | done — видалено | skip — не було на сайті
  doneAt     DateTime?
  doneBy     String?
  deleted    DeletedProduct @relation(fields: [deletedId], references: [id], onDelete: Cascade)

  @@unique([deletedId, site])
  @@index([site, status])
}

// Списання: брак, втрата, пересорт, власні потреби, повернення постачальнику
model WriteOff {
  id          Int            @id @default(autoincrement())
  number      String         @unique
  date        DateTime       @default(now())
  warehouseId Int
  reason      String         @default("Брак")
  note        String?
  status      String         @default("draft") // draft | posted
  total       Float          @default(0) // за собівартістю
  createdById Int
  postedAt    DateTime?
  createdAt   DateTime       @default(now())
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  createdBy   User           @relation(fields: [createdById], references: [id])
  lines       WriteOffLine[]
}

model WriteOffLine {
  id         Int      @id @default(autoincrement())
  writeOffId Int
  productId  Int
  qty        Float
  cost       Float    @default(0) // собівартість за одиницю на момент списання
  cellId     Int?
  writeOff   WriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  cell       Cell?    @relation(fields: [cellId], references: [id], onDelete: SetNull)
}

// Номери ТТН заявки (Нова пошта, Укрпошта…) — щоб знаходити замовлення скануванням наклейки
model OrderTtn {
  ttn     String  @id // нормалізований: без пробілів, великими літерами
  orderId Int
  order   SdOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Пакування в додатку (у SalesDrive нічого не змінюється)
model OrderPack {
  orderId    Int      @id
  packedAt   DateTime @default(now())
  packedBy   String?
  checked    Boolean  @default(true) // true — усі товари перевірено сканером; false — запаковано без перевірки
  scanned    String?  // JSON: що й скільки відскановано
  order      SdOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// Товари на Prom (з API) і що там зараз стоїть — щоб відправляти лише зміни наявності
model PromLink {
  promId     String    @id // ID товару на Prom
  externalId String?   // ID з файлу імпорту (= ID товару в SalesDrive)
  sku        String?
  name       String?
  presence   String?   // available | not_available | order | waiting | service
  qty        Int?      // quantity_in_stock на Prom
  keywordsUa String?   // пошукові запити українською на Prom (список читаємо з X-LANGUAGE: uk)
  kwPushedAt DateTime? // коли додаток записав українські запити
  catId      String?   // категорія порталу Prom (від неї залежить комісія)
  catName    String?
  pushedAt   DateTime? // коли додаток востаннє змінив наявність
  updatedAt  DateTime  @updatedAt

  @@index([externalId])
  @@index([sku])
}

// Фото, завантажені в додаток (віддаються публічно за адресою /img/<id>, щоб SalesDrive і сайти могли їх забрати)
model ProductImage {
  id        String   @id @default(cuid())
  productId Int
  mime      String
  data      Bytes
  createdAt DateTime @default(now())

  @@index([productId])
}
