// Схема бази даних складського сервісу для SalesDrive.
// SalesDrive — джерело правди для товарів і залишків.
// Тут зберігаємо те, чого в CRM немає: комірки, документи приходу, журнал дій, витрати.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // з'єднання через пул (для сайту)
  directUrl = env("DIRECT_URL")   // пряме з'єднання (для npm run db:push)
}

model User {
  id           Int        @id @default(autoincrement())
  name         String
  login        String     @unique
  passwordHash String
  role         String     @default("manager") // admin | manager | storekeeper
  active       Boolean    @default(true)
  passwordChangedAt DateTime @default(now()) // зміна пароля завершує всі старі сесії
  createdAt    DateTime   @default(now())
  receipts     Receipt[]  @relation("ReceiptCreatedBy")
  posted       Receipt[]  @relation("ReceiptPostedBy")
  logs         ActionLog[]
  expenses     Expense[]
  inventories  Inventory[]
  moves        StockMove[]
  writeOffs    WriteOff[]
}

// Склад (точка). sdStockId — ID складу в SalesDrive (Установки → ... → API).
model Warehouse {
  id        Int            @id @default(autoincrement())
  name      String
  sdStockId String?
  isDefault Boolean        @default(false)
  createdAt DateTime       @default(now())
  cells     Cell[]
  stocks    StockBalance[]
  receipts  Receipt[]
  expenses  Expense[]
  inventories Inventory[]
  moves     StockMove[]
  writeOffs WriteOff[]
}

model Supplier {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  phone     String?
  note      String?
  createdAt DateTime  @default(now())
  receipts  Receipt[]
  codes     ProductCode[]
}

model Product {
  id               Int            @id @default(autoincrement())
  sdId             String?        @unique // поле "ID" у SalesDrive
  name             String
  nameForDocuments String?
  nameTranslate    String?        // назва другою мовою (у SalesDrive: nameTranslate); порожня — іде основна
  categorySdId     String?
  categoryName     String?
  price            Float          @default(0) // ціна продажу (у SalesDrive: costPerItem)
  priceCurrency    String?        // валюта ціни продажу (зазвичай UAH)
  cost             Float          @default(0) // собівартість у гривні (у SalesDrive: expenses)
  costCurrency     String?        // валюта закупівлі (USD, EUR…), якщо собівартість задана у валюті
  costOriginal     Float?         // собівартість у валюті закупівлі
  discountValue    Float?
  discountType     String?        // percent | amount
  discountFrom     DateTime?
  discountTo       DateTime?
  sku              String?
  barcode          String?
  manufacturer     String?
  supplierName     String?
  description      String?        // опис (HTML або текст), іде в SalesDrive
  descriptionTranslate String?    // опис другою мовою (у SalesDrive: descriptionTranslate)
  params           String?        // характеристики: JSON [{name, type, value}]
  search           String         @default("") // нижній регістр: назва + sku + штрихкод + ID, для пошуку
  deletedAt        DateTime?      // видалено (у CRM або з додатку) — у списках не показується, історія зберігається
  baseProductId    Int?           // картка-комплект (вітрина для SEO): посилається на основний фізичний товар
  kitQty           Float          @default(1) // скільки штук основного товару в одній картці
  sdKitPending     Boolean        @default(false) // картку створено в додатку — у SalesDrive ще треба позначити «Комплект» і додати основний
  base             Product?       @relation("KitBase", fields: [baseProductId], references: [id], onDelete: SetNull)
  kits             Product[]      @relation("KitBase")
  syncedAt         DateTime?      // коли востаннє оновлено з SalesDrive
  syncError        String?        // остання помилка відправки в SalesDrive
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  stocks           StockBalance[]
  cells            ProductCell[]
  receiptLines     ReceiptLine[]
  codes            ProductCode[]
  moves            StockMove[]
  inventoryLines   InventoryLine[]
  saleLines        SdOrderLine[]
  writeOffLines    WriteOffLine[]

  @@index([barcode])
  @@index([sku])
  @@index([baseProductId])
}

// Копія залишку із SalesDrive по складу
model StockBalance {
  productId   Int
  warehouseId Int
  qty         Float     @default(0)
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
}

// Комірка: код на кшталт "A-03-2" (ряд-стелаж-полиця)
model Cell {
  id          Int           @id @default(autoincrement())
  code        String
  warehouseId Int
  note        String?
  createdAt   DateTime      @default(now())
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  products    ProductCell[]
  lines       ReceiptLine[]
  inventoryLines InventoryLine[]
  moves       StockMove[]
  writeOffLines WriteOffLine[]

  @@unique([warehouseId, code])
}

// Що лежить у комірці (один товар може бути в кількох комірках)
model ProductCell {
  productId Int
  cellId    Int
  qty       Float    @default(0)
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cell      Cell     @relation(fields: [cellId], references: [id], onDelete: Cascade)

  @@id([productId, cellId])
}

// Документ приходу
model Receipt {
  id          Int           @id @default(autoincrement())
  number      String        @unique
  date        DateTime      @default(now())
  warehouseId Int
  supplierId  Int?
  invoiceNo   String?       // номер накладної постачальника
  note        String?
  status      String        @default("draft") // draft | posted
  currency    String        @default("UAH") // валюта закупівлі
  rate        Float         @default(1)     // курс до гривні на момент приходу (з SalesDrive)
  total       Float         @default(0)     // сума в гривні
  totalCurrency Float       @default(0)     // сума у валюті приходу
  createdById Int
  postedById  Int?
  postedAt    DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  warehouse   Warehouse     @relation(fields: [warehouseId], references: [id])
  supplier    Supplier?     @relation(fields: [supplierId], references: [id])
  createdBy   User          @relation("ReceiptCreatedBy", fields: [createdById], references: [id])
  postedBy    User?         @relation("ReceiptPostedBy", fields: [postedById], references: [id])
  lines       ReceiptLine[]

  @@index([date])
}

model ReceiptLine {
  id        Int     @id @default(autoincrement())
  receiptId Int
  productId Int
  qty       Float
  cost      Float   // закупівельна ціна за одиницю у валюті приходу
  newPrice  Float?  // нова ціна продажу (якщо змінюємо при приході)
  cellId    Int?
  receipt   Receipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
  cell      Cell?   @relation(fields: [cellId], references: [id], onDelete: SetNull)
}

// Витрати — на майбутнє (оренда, доставка, зарплата…)
model Expense {
  id          Int        @id @default(autoincrement())
  date        DateTime   @default(now())
  category    String
  amount      Float
  warehouseId Int?
  legalEntity String?    // ФОП
  note        String?
  createdById Int
  createdAt   DateTime   @default(now())
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  createdBy   User       @relation(fields: [createdById], references: [id])
}

// Журнал дій: хто, що і коли зробив
model ActionLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

model Setting {
  key   String @id
  value String
}

// Спроби входу: для захисту від підбору пароля і для журналу
model LoginAttempt {
  id        Int      @id @default(autoincrement())
  login     String
  ip        String
  ok        Boolean
  createdAt DateTime @default(now())

  @@index([login, createdAt])
  @@index([ip, createdAt])
}

// Додаткові коди товару: артикули постачальників і додаткові штрихкоди (напр. заводський).
// Пошук у приході, на складі й в інвентаризації працює за всіма кодами.
model ProductCode {
  id         Int       @id @default(autoincrement())
  productId  Int
  code       String    @unique
  type       String    // supplier | barcode
  supplierId Int?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// Журнал руху товару: прихід, інвентаризація, переміщення між комірками, автосписання з комірок після продажу
model StockMove {
  id          Int       @id @default(autoincrement())
  productId   Int
  warehouseId Int
  cellId      Int?
  qty         Float     // + надходження в комірку/на склад, - вибуття
  type        String    // receipt | inventory | cell-move | cell-adjust | sale-auto
  docType     String?   // receipt | inventory
  docId       Int?
  note        String?
  userId      Int?
  createdAt   DateTime  @default(now())
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  cell        Cell?     @relation(fields: [cellId], references: [id], onDelete: SetNull)
  user        User?     @relation(fields: [userId], references: [id])

  @@index([productId, createdAt])
  @@index([cellId])
}

model Inventory {
  id          Int             @id @default(autoincrement())
  number      String          @unique
  date        DateTime        @default(now())
  warehouseId Int
  status      String          @default("draft") // draft | posted
  note        String?
  createdById Int
  postedAt    DateTime?
  createdAt   DateTime        @default(now())
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  createdBy   User            @relation(fields: [createdById], references: [id])
  lines       InventoryLine[]
}

model InventoryLine {
  id          Int       @id @default(autoincrement())
  inventoryId Int
  productId   Int
  cellId      Int?
  counted     Float
  systemQty   Float?    // залишок у SalesDrive на момент проведення (заповнюється при проведенні)
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])
  cell        Cell?     @relation(fields: [cellId], references: [id], onDelete: SetNull)
}

// Заявки з SalesDrive — лише те, що потрібно для звітів. Дані клієнтів НЕ зберігаємо.
model SdOrder {
  id          Int           @id // ID заявки в SalesDrive
  orderTime   DateTime
  updateAt    DateTime?
  statusId    Int
  amount      Float         @default(0) // сума заявки
  costAmount  Float         @default(0) // собівартість
  profit      Float         @default(0)
  lines       SdOrderLine[]
  ttns        OrderTtn[]
  pack        OrderPack?

  @@index([orderTime])
}

model SdOrderLine {
  id        Int      @id @default(autoincrement())
  orderId   Int
  productId Int?     // наш товар, якщо вдалося зіставити
  sdProductId String?
  name      String
  sku       String?
  barcode   String?
  qty       Float
  price     Float
  discount  Float    @default(0)
  costPrice Float    @default(0)
  order     SdOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([productId])
}

// Курси валют із SalesDrive (кеш; оновлюється при синхронізації)
model Currency {
  code      String   @id
  rate      Float    // скільки гривень за 1 одиницю валюти
  updatedAt DateTime @updatedAt
}

// Шаблон заповнення нового товару: опис і характеристики за категорією (categoryName = null — для всіх)
model ProductTemplate {
  id           Int      @id @default(autoincrement())
  name         String
  categoryName String?  @unique
  description  String?  // можна використовувати {name}, {sku}, {manufacturer}, {category}, {supplier}
  params       String?  // JSON [{name, type, value}]
  manufacturer String?
  supplierName String?
  updatedAt    DateTime @updatedAt
}

// Журнал видалених товарів: щоб не забути прибрати їх на Prom, Horoshop та інших сайтах
model DeletedProduct {
  id          Int                  @id @default(autoincrement())
  productId   Int?
  sdId        String?
  name        String
  sku         String?
  barcode     String?
  categoryName String?
  price       Float    @default(0)
  source      String               // app — видалено в додатку; crm — зник із SalesDrive
  reason      String?
  deletedById Int?
  deletedAt   DateTime             @default(now())
  sites       DeletedProductSite[]

  @@index([deletedAt])
}

model DeletedProductSite {
  id         Int            @id @default(autoincrement())
  deletedId  Int
  site       String         // назва сайту з Налаштувань (Prom, Horoshop…)
  status     String         @default("todo") // todo — треба видалити | done — видалено | skip — не було на сайті
  doneAt     DateTime?
  doneBy     String?
  deleted    DeletedProduct @relation(fields: [deletedId], references: [id], onDelete: Cascade)

  @@unique([deletedId, site])
  @@index([site, status])
}

// Списання: брак, втрата, пересорт, власні потреби, повернення постачальнику
model WriteOff {
  id          Int            @id @default(autoincrement())
  number      String         @unique
  date        DateTime       @default(now())
  warehouseId Int
  reason      String         @default("Брак")
  note        String?
  status      String         @default("draft") // draft | posted
  total       Float          @default(0) // за собівартістю
  createdById Int
  postedAt    DateTime?
  createdAt   DateTime       @default(now())
  warehouse   Warehouse      @relation(fields: [warehouseId], references: [id])
  createdBy   User           @relation(fields: [createdById], references: [id])
  lines       WriteOffLine[]
}

model WriteOffLine {
  id         Int      @id @default(autoincrement())
  writeOffId Int
  productId  Int
  qty        Float
  cost       Float    @default(0) // собівартість за одиницю на момент списання
  cellId     Int?
  writeOff   WriteOff @relation(fields: [writeOffId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
  cell       Cell?    @relation(fields: [cellId], references: [id], onDelete: SetNull)
}

// Номери ТТН заявки (Нова пошта, Укрпошта…) — щоб знаходити замовлення скануванням наклейки
model OrderTtn {
  ttn     String  @id // нормалізований: без пробілів, великими літерами
  orderId Int
  order   SdOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// Пакування в додатку (у SalesDrive нічого не змінюється)
model OrderPack {
  orderId    Int      @id
  packedAt   DateTime @default(now())
  packedBy   String?
  checked    Boolean  @default(true) // true — усі товари перевірено сканером; false — запаковано без перевірки
  scanned    String?  // JSON: що й скільки відскановано
  order      SdOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}
